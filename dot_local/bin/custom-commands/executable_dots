#!/bin/bash

case "$1" in 
    update)
        chezmoi update --refresh-externals
        ;;
    push)
        chezmoi re-add
        ;;
    add)
        chezmoi add "$2"
        ;;
    nvim)
        if [ -n "$2" ]; then
            msg="$2"
        else
            read -rp "Commit message [Update nvim config]: " msg
            msg="${msg:-"Update nvim config"}"
        fi
        git -C ~/.config/nvim add -A
        git -C ~/.config/nvim commit -m "$msg"
        git -C ~/.config/nvim push
        ;;
    cd)
        chezmoi cd
        ;;
    *)
        echo "Usage: dots [command]"
        echo ""
        echo "Commands:"
        echo "  update    Pull latest dotfiles from remote and apply them"
        echo "  push      Re-add changed dotfiles and push to repo"
        echo "  add       Add a file to chezmoi (e.g. dots add ~/.bashrc)"
        echo "  nvim      Commit and push nvim config changes"
        ;;
esac

