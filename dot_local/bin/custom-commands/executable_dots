#!/bin/bash

case "$1" in
    --subcommands)
        echo -e "update\npush\nadd\nremove\nupdate-nvim\ncd"
        ;;
    update)
        chezmoi update --refresh-externals
        ;;
    push)
        chezmoi re-add
        ;;
    add)
        chezmoi add "$2"
        ;;
    update-nvim)
        if [ -n "$2" ]; then
            msg="$2"
        else
            read -rp "Commit message [Update nvim config]: " msg
            msg="${msg:-"Update nvim config"}"
        fi
        git -C ~/.config/nvim add -A
        git -C ~/.config/nvim commit -m "$msg"
        git -C ~/.config/nvim push
        ;;
    remove)
        chezmoi forget "$2"
        ;;
    cd)
        chezmoi cd
        ;;
    *)
        sub=$(dots --subcommands | sort | gum choose --header "dots")
        [ -n "$sub" ] && dots "$sub"
        ;;
esac

