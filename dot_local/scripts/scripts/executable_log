#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MAIN_COLOR="212"
WARN_COLOR="208"
ERROR_COLOR="196"
SUCCESS_COLOR="71"

log() {
    gum log --level info -- "$*"
}

warn() {
    gum log --level warn -- "$*"
}

error() {
    gum log --level error -- "✗  $*"
}

success() {
    gum style --foreground "$SUCCESS_COLOR" --bold -- "✓  $*"
}

box() {
    local title="$1"
    gum style \
        --foreground "$MAIN_COLOR" \
        --border-foreground "$MAIN_COLOR" \
        --border rounded \
        --padding "1 1" \
        --margin "1 0" \
        --bold \
        "$title"
}

_divider() {
    local text="$1"
    local color="$2"
    local total_width="$3"
    local bold="$4"
    local line_char="${5:-━}"

    local text_with_padding=" $text "
    local text_length=${#text_with_padding}
    local remaining=$((total_width - text_length))
    local left_side=$((remaining / 2))
    local right_side=$((remaining - left_side))

    local left_line=$(printf "${line_char}%.0s" $(seq 1 $left_side))
    local right_line=$(printf "${line_char}%.0s" $(seq 1 $right_side))

    echo ""
    if [[ "$bold" == "true" ]]; then
        gum style --bold --foreground "$color" "${left_line}${text_with_padding}${right_line}"
    else
        gum style --foreground "$color" "${left_line}${text_with_padding}${right_line}"
    fi
    echo ""
}

chapter() {
    _divider "$1" "${2:-212}" "${3:-80}" "true" "═"
}

section() {
    _divider "$1" "${2:-212}" "${3:-80}" "false" "━"
}

case "$1" in
    warn) shift; warn "$@";;
    error) shift; error "$@";;
    success) shift; success "$@";;
    chapter) shift; chapter "$@";;
    section) shift; section "$@";;
    *) log "$@";;
esac
