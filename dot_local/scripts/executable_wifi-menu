#!/usr/bin/env bash

notify-send "Getting list of available Wi-Fi networks..."

# Function to convert signal strength to bars
signal_bars() {
    local signal=$1
    if [[ $signal -ge 80 ]]; then
        echo "󰤨"  # Full bars
    elif [[ $signal -ge 60 ]]; then
        echo "󰤥"  # 3 bars
    elif [[ $signal -ge 40 ]]; then
        echo "󰤢"  # 2 bars
    elif [[ $signal -ge 20 ]]; then
        echo "󰤟"  # 1 bar
    else
        echo "󰤯"  # No signal
    fi
}

# Get wifi list with signal strength, BSSID and active status
wifi_raw=$(nmcli --fields "ACTIVE,SIGNAL,SECURITY,SSID,BSSID" device wifi list | sed 1d)

# Get saved connections
saved_connections=$(nmcli -g NAME connection)

# Process wifi list to add signal bars and connection indicator
wifi_array=()
connected_wifi=""
while IFS= read -r line; do
    if [[ -n "$line" && ! "$line" =~ ^[[:space:]]*$ ]]; then
        # Extract active, signal, security, SSID, and BSSID
        active=$(echo "$line" | awk '{print $1}')
        signal=$(echo "$line" | awk '{print $2}')
        security=$(echo "$line" | awk '{print $3}')
        # Get the rest of the line, then extract BSSID (last field) and SSID (everything in between)
        rest=$(echo "$line" | awk '{for(i=4;i<=NF;i++) printf "%s ", $i; print ""}' | sed 's/ $//')
        bssid=$(echo "$rest" | awk '{print $NF}')
        ssid=$(echo "$rest" | sed "s/ $bssid$//" | sed 's/^ *//' | sed 's/ *$//')
        
        # Skip empty SSIDs
        if [[ -z "$ssid" || "$ssid" == "--" ]]; then
            continue
        fi
        
        # Get signal bars
        bars=$(signal_bars "$signal")
        
        # Add security icon
        if [[ "$security" =~ WPA ]]; then
            sec_icon=" "
        else
            sec_icon=" "
        fi
        
        # Add connection/saved indicator (prioritize connection over saved)
        if [[ "$active" == "yes" ]]; then
            status_icon="󰱓 "
        elif [[ $(echo "$saved_connections" | grep -w "$ssid") = "$ssid" ]]; then
            status_icon="◆ "
        else
            status_icon="  "
        fi
        
        # Format line with status, signal, ssid, security
        formatted_line="${status_icon}${bars}  ${ssid}${sec_icon}"
        
        if [[ "$active" == "yes" ]]; then
            # Store connected wifi separately to put it at the top
            connected_wifi="$formatted_line"
        else
            # Store with signal strength for sorting (signal:formatted_line)
            wifi_array+=("${signal}:${formatted_line}")
        fi
    fi
done <<< "$wifi_raw"

# Sort wifi array by signal strength (descending) and format
wifi_list=""
while IFS= read -r line; do
    if [[ -n "$line" ]]; then
        # Extract the formatted part after the signal strength
        formatted_line="${line#*:}"
        wifi_list+="${formatted_line}\n"
    fi
done < <(printf '%s\n' "${wifi_array[@]}" | sort -t: -k1,1nr)

# Combine connected wifi at top, then sorted networks
if [[ -n "$connected_wifi" ]]; then
    wifi_list="${connected_wifi}\n${wifi_list}"
fi

connected=$(nmcli -fields WIFI g)
if [[ "$connected" =~ "enabled" ]]; then
	toggle="   󰖪  Disable Wi-Fi"
elif [[ "$connected" =~ "disabled" ]]; then
	toggle="   󰖩  Enable Wi-Fi"
fi

# Add forget option
forget_option="   󰚃  Forget current WiFi Network"

# Use rofi to select wifi network
chosen_network=$(echo -e "$toggle\n$forget_option\n$wifi_list" | uniq -u | rofi -dmenu -i -selected-row 2 -p "Wi-Fi SSID: " )

# Extract SSID from formatted line using sed to remove all icons
# Remove status icon, signal icon, leading/trailing spaces, and security icon
chosen_id=$(echo "$chosen_network" | sed 's/^[󰱓◆[:space:]]*//' | sed 's/^[󰤨󰤥󰤢󰤟󰤯]//' | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//' | sed 's/[[:space:]]*$//')

# Clean up any trailing whitespace and security icons
chosen_id=$(echo "$chosen_id" | sed 's/[[:space:]]*$//' | sed 's/[[:space:]]*$//')
chosen_id=$(echo "$chosen_id" | sed 's/[[:space:]]*$//')

if [ "$chosen_network" = "" ]; then
	exit
elif [ "$chosen_network" = "   󰖩  Enable Wi-Fi" ]; then
	nmcli radio wifi on
	# Wait for WiFi to scan for networks
	sleep 2
	# Reopen menu after enabling WiFi
	exec "$0"
elif [ "$chosen_network" = "   󰖪  Disable Wi-Fi" ]; then
	nmcli radio wifi off
	# Reopen menu after disabling WiFi
	exec "$0"
elif [ "$chosen_network" = "   󰚃  Forget current WiFi Network" ]; then
	# Get currently connected network
	current_ssid=$(nmcli -t -f active,ssid dev wifi | egrep '^yes' | cut -d\: -f2)
	if [[ -n "$current_ssid" ]]; then
		nmcli connection delete id "$current_ssid" && notify-send "WiFi Forgotten" "Removed saved connection for \"$current_ssid\"."
	else
		notify-send "No Connection" "No WiFi network is currently connected."
	fi
	# Reopen menu after forgetting network
	exec "$0"
else
	# Message to show when connection is activated successfully
  	success_message="You are now connected to the Wi-Fi network \"$chosen_id\"."
	# Get saved connections
	saved_connections=$(nmcli -g NAME connection)
	if [[ $(echo "$saved_connections" | grep -w "$chosen_id") = "$chosen_id" ]]; then
		# Try saved connection first (like wifi-tui does)
		notify-send "Connecting..." "Using saved connection for \"$chosen_id\"..."
		connect_result=$(nmcli connection up "$chosen_id" 2>&1)
		
		if [[ "$connect_result" =~ "successfully" ]]; then
			notify-send "Connection Established" "$success_message"
		else
			# If saved connection fails, recreate it with new password
			notify-send "Reconnecting..." "Saved connection failed, creating fresh profile for \"$chosen_id\"..."
			if [[ "$chosen_network" =~ " " ]]; then
				wifi_password=$(rofi -dmenu -password -p "Enter Password" -theme-str 'entry { placeholder: "Password"; }' )
				if [[ -n "$wifi_password" ]]; then
					# Use the same approach as wifi-tui: create connection profile manually
					nmcli connection delete "$chosen_id" 2>/dev/null
					nmcli connection add type wifi con-name "$chosen_id" ssid "$chosen_id" 2>/dev/null
					nmcli connection modify "$chosen_id" wifi-sec.key-mgmt wpa-psk 2>/dev/null
					nmcli connection modify "$chosen_id" wifi-sec.psk "$wifi_password" 2>/dev/null
					connect_result=$(nmcli connection up "$chosen_id" 2>&1)
					if [[ "$connect_result" =~ "successfully" ]]; then
						notify-send "Connection Established" "$success_message"
					elif [[ "$connect_result" =~ "invalid" ]] || [[ "$connect_result" =~ "wrong" ]] || [[ "$connect_result" =~ "authentication" ]] || [[ "$connect_result" =~ "timeout" ]]; then
						notify-send "Wrong Password" "Incorrect password for \"$chosen_id\""
					else
						notify-send "Connection Failed" "Error: $connect_result"
					fi
				else
					notify-send "Connection Cancelled" "Password required to connect to \"$chosen_id\""
				fi
			else
				# Open network - recreate profile
				nmcli connection delete "$chosen_id" 2>/dev/null
				connect_result=$(nmcli device wifi connect "$chosen_id" 2>&1)
				if [[ "$connect_result" =~ "successfully" ]]; then
					notify-send "Connection Established" "$success_message"
				else
					notify-send "Connection Failed" "Error: $connect_result"
				fi
			fi
		fi
	else
		if [[ "$chosen_network" =~ " " ]]; then
			wifi_password=$(rofi -dmenu -password -p "Enter Password" -theme-str 'entry { placeholder: "Password"; }' )
			if [[ -n "$wifi_password" ]]; then
				notify-send "Connecting..." "Attempting to connect to \"$chosen_id\""
				# Use the same approach as wifi-tui: create connection profile manually
				nmcli connection delete "$chosen_id" 2>/dev/null
				nmcli connection add type wifi con-name "$chosen_id" ssid "$chosen_id" 2>/dev/null
				nmcli connection modify "$chosen_id" wifi-sec.key-mgmt wpa-psk 2>/dev/null
				nmcli connection modify "$chosen_id" wifi-sec.psk "$wifi_password" 2>/dev/null
				connect_result=$(nmcli connection up "$chosen_id" 2>&1)
				if [[ "$connect_result" =~ "successfully" ]]; then
					notify-send "Connection Established" "$success_message"
				elif [[ "$connect_result" =~ "invalid" ]] || [[ "$connect_result" =~ "wrong" ]] || [[ "$connect_result" =~ "authentication" ]] || [[ "$connect_result" =~ "timeout" ]]; then
					notify-send "Wrong Password" "Incorrect password for \"$chosen_id\""
				else
					notify-send "Connection Failed" "Error: $connect_result"
				fi
			else
				notify-send "Connection Cancelled" "Password required to connect to \"$chosen_id\""
			fi
		else
			# Open network, no password needed
			connect_result=$(nmcli device wifi connect "$chosen_id" 2>&1)
			if [[ "$connect_result" =~ "successfully" ]]; then
				notify-send "Connection Established" "$success_message"
			else
				notify-send "Connection Failed" "Could not connect to \"$chosen_id\""
			fi
		fi
    fi
fi