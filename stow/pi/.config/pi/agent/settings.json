  "shellCommandPrefix": "export EDITOR=nvim",
  "packages": [
    "git:github.com/badlogic/pi-skills",
    "npm:pi-mcp-adapter",
    "npm:pi-claude-agent-sdk"
  ],
  "hideThinkingBlock": false,
  "extensions": [
    "-builtin:mcp"
  ]
}