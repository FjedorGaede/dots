[
  {
    "plugin_id": "focus-history",
    "name": "Focus History",
    "version": "0.1.0",
    "min_herdr_version": "0.9.0",
    "description": "Vim-style back/forward history for workspace and agent focus",
    "manifest_path": "/home/fjedor/projects/herdr-focus-history/herdr-plugin.toml",
    "plugin_root": "/home/fjedor/projects/herdr-focus-history",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "agent-back",
        "title": "Jump to previous agent",
        "command": [
          "bash",
          "src/navigate.sh",
          "agent",
          "back"
        ]
      },
      {
        "id": "agent-forward",
        "title": "Jump to next agent",
        "command": [
          "bash",
          "src/navigate.sh",
          "agent",
          "forward"
        ]
      },
      {
        "id": "workspace-back",
        "title": "Jump to previous workspace",
        "command": [
          "bash",
          "src/navigate.sh",
          "workspace",
          "back"
        ]
      },
      {
        "id": "workspace-forward",
        "title": "Jump to next workspace",
        "command": [
          "bash",
          "src/navigate.sh",
          "workspace",
          "forward"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.closed",
        "command": [
          "bash",
          "src/close.sh",
          "agent"
        ]
      },
      {
        "on": "pane.focused",
        "command": [
          "bash",
          "src/record.sh",
          "agent"
        ]
      },
      {
        "on": "workspace.closed",
        "command": [
          "bash",
          "src/close.sh",
          "workspace"
        ]
      },
      {
        "on": "workspace.focused",
        "command": [
          "bash",
          "src/record.sh",
          "workspace"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
