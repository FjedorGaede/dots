nmap("<leader>ff", function() Snacks.picker.files({ live = true, hidden = true }) end, "[F]ind [F]iles")
nmap("<leader>fs", function() Snacks.picker.grep({ live = true, hidden = true }) end, "[F]ind [S]tring in Files")
