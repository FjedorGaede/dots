-- Keymaps
-- NOTE I want to use  m and
local keymap = vim.keymap.set

local function nmap(keys, callback, desc)
	keymap("n", keys, callback, { desc = desc })
end

local function xmap(keys, callback, desc)
	keymap("x", keys, callback, { desc = desc })
end

