#!/usr/bin/env bash

# waydroid-register - whitelist the Waydroid Android with Google (once per init)
#
# A Waydroid GAPPS image is an "uncertified device": the Play Store refuses to
# log in / install until its GSF android_id is registered at
# https://www.google.com/android/uncertified. This script starts the Android
# session if needed, reads the id, copies it to the clipboard and opens the
# page. After registering: wait a few minutes, then 'waydroid session stop'
# and start Waydroid again.
#
# Installed by: dots setup waydroid
#
# Usage: waydroid-register

set -euo pipefail

URL=https://www.google.com/android/uncertified

if ! waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING'; then
    echo "starting waydroid session…"
    waydroid session start >/dev/null 2>&1 &
    for _ in $(seq 60); do
        waydroid status 2>/dev/null | grep -q 'Session:.*RUNNING' && break
        sleep 1
    done
fi

# GSF writes its database a while after the first boot → retry
id=""
for _ in $(seq 30); do
    id="$(sudo waydroid shell -- sh -c \
        "ANDROID_RUNTIME_ROOT=/apex/com.android.runtime ANDROID_DATA=/data \
         ANDROID_TZDATA_ROOT=/apex/com.android.tzdata ANDROID_I18N_ROOT=/apex/com.android.i18n \
         sqlite3 /data/data/com.google.android.gsf/databases/gservices.db \
         \"select value from main where name = 'android_id';\"" 2>/dev/null | tr -d '[:space:]')"
    [ -n "$id" ] && break
    sleep 2
done

if [ -z "$id" ]; then
    echo "no android_id yet — is this a GAPPS image? open Waydroid once, then retry" >&2
    exit 1
fi

echo "android_id: $id"
printf '%s' "$id" | wl-copy 2>/dev/null && echo "(copied to clipboard)"
echo "register it at $URL, wait a few minutes, then: waydroid session stop"
xdg-open "$URL" >/dev/null 2>&1 &
