#!/bin/bash
SESSION="pi-quick"
SESSION_DIR="$HOME/.local/share/pi-quick/sessions"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux switch-client -t "$SESSION"
else
    mkdir -p "$SESSION_DIR"
    tmux new-session -d -s "$SESSION" -c "$HOME" \
        pi --no-builtin-tools --no-context-files \
           --session-dir "$SESSION_DIR" \
           --system-prompt "You are a quick-research assistant. Answer questions concisely and directly. Use web search to find current information when needed. Do not write code or create files unless explicitly asked. Keep responses brief and to the point - think of yourself as a smarter search engine."
    tmux switch-client -t "$SESSION"
fi