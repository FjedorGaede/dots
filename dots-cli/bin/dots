#!/usr/bin/env bash
# dots — single entrypoint for the dotfiles CLI.
# Dispatches to lib/<cmd>.sh; all logic lives there. See ../AGENTS.md.
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"

# shellcheck source=../lib/common.sh
source "$LIB_DIR/common.sh"

main "$@"
